# Secrets - never commit
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Logs and caches
logs/*.log
logs/*.csv
.cache/

# Data: FMP's free plan is personal-use only, so downloads are never committed. Each person re-downloads.
data/raw/*
!data/raw/.gitkeep

# The dataset is built from FMP data under a personal-use licence: do not publish it (in any file format)
data/clean/

# Results are derived from the same FMP data: not published either. Everyone rebuilds them with python run_all.py
outputs/
